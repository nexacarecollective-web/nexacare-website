<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Exacare NDIS Services</title>
    <link rel="stylesheet" href="styles.css" />
</head>
<body>
    <header>
        <h1>Exacare NDIS Services</h1>
        <nav>
            <a href="#services">Services</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>
    <main>
        <section id="intro">
            <h2>Welcome to Exacare</h2>
            <p>Your trusted partner for NDIS support coordination and care services.</p>
        </section>
        <section id="services">
            <h2>Our Services</h2>
            <ul>
                <li>Support Coordination</li>
                <li>Plan Management</li>
                <li>Therapy Services</li>
                <li>Community Access Support</li>
            </ul>
        </section>
        <section id="contact">
            <h2>Contact Us</h2>
            <form>
                <label for="name">Name:</label><br/>
                <input type="text" id="name" name="name" required /><br/>
                <label for="email">Email:</label><br/>
                <input type="email" id="email" name="email" required /><br/>
                <label for="message">Message:</label><br/>
                <textarea id="message" name="message" rows="4" required></textarea><br/>
                <button type="submit">Send</button>
            </form>
            <p><em>Note: This form is a placeholder and does not submit data.</em></p>
        </section>
    </main>
    <footer>
        <p>&copy; 2025 Exacare NDIS Services</p>
    </footer>
</body>
</html>
